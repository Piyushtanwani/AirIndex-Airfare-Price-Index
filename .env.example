# AirIndex configuration.
# Copy to .env and edit. Every value here has a working default, so the project runs
# without this file at all.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite by default, so the project runs with no external service. Use PostgreSQL for
# anything beyond a laptop demonstration; the Docker Compose file provides one.
# DATABASE_URL=postgresql+psycopg://airindex:airindex@localhost:5432/airindex
# Or supply the parts and let the application assemble the URL. DATABASE_URL,
# when set, always wins over these.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=airindex
# DB_USER=airindex
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read endpoints are open in development. Set this to true to require a key on every
# request. Admin endpoints always require an admin key regardless.
API_KEY_REQUIRED=false

# CHANGE BOTH OF THESE BEFORE DEPLOYING ANYWHERE. The shipped defaults are refused
# outright whenever ENVIRONMENT is not "development", so a deployment that forgets to
# change them fails closed rather than running wide open.
ADMIN_API_KEY=dev-admin-key-change-me
READ_API_KEYS=dev-read-key

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Collection
# ---------------------------------------------------------------------------
# Comma-separated. Available: synthetic, feed, indigo, airindia, makemytrip.
# The live portal adapters additionally require COLLECTOR_LIVE_ADAPTERS_ENABLED and a
# Terms of Service review recorded in docs/compliance.md. Read that file first.
COLLECTOR_ENABLED_SOURCES=synthetic

# Identify the crawler honestly and give a real contact address before collecting from
# anyone else's servers.
COLLECTOR_USER_AGENT=AirIndexBot/0.1 (SIH26056 research prototype; contact: team-visionx@example.org)

COLLECTOR_REQUESTS_PER_MINUTE=20
COLLECTOR_MAX_REQUESTS_PER_RUN=500

# Leave this true. Setting it to false disables the robots.txt gate, which is the
# single control that keeps this project defensible.
COLLECTOR_RESPECT_ROBOTS=true

# Live portal scraping. Off by default and should stay off until the Terms of Service
# review for each portal has been completed and recorded.
COLLECTOR_LIVE_ADAPTERS_ENABLED=false

SYNTHETIC_SEED=26056

# ---------------------------------------------------------------------------
# Scheduler
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=3
SCHEDULER_CRON_MINUTE=0

# ---------------------------------------------------------------------------
# Licensed feed adapter (optional)
# ---------------------------------------------------------------------------
# FEED_URL_TEMPLATE=https://provider.example/v1/fares?from={origin}&to={destination}&date={date}
# FEED_API_KEY=
# FEED_RESULTS_PATH=data.offers
# FEED_FIELD_MAP={"total_fare":"total_amount","airline":"carrier_code"}

# ---------------------------------------------------------------------------
# Analyst (optional)
# ---------------------------------------------------------------------------
# Without a key the analyst answers deterministically from the data, which is the
# default and involves no language model at all. With a key, Claude phrases the same
# evidence under the same grounding rules.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
# VITE_API_KEY=
